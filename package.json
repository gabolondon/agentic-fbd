{
  "name": "logic-builder-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc -p packages/core && tsc -p packages/cli && tsc -p packages/viewer",
    "build:cli": "node packages/cli/build.mjs",
    "build": "npm run build:viewer && npm run build:cli",
    "dev": "npm run dev -w @logic-builder/viewer",
    "build:viewer": "npm run build -w @logic-builder/viewer",
    "test:e2e": "playwright test",
    "check:dist": "npm run build && git diff --exit-code -- dist"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
